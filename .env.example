# ================= SERVER =================
PORT=3000
NODE_ENV=production

# lamba random hex
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=badlo_ye_kuch_lamba_random

# Render service ka domain (https://xyz.onrender.com). APK ke andar bake hota hai,
# isliye domain final hone ke BAAD hi build karo.
BASE_URL=https://your-service.onrender.com

# free tier pe disk ephemeral hai — /tmp hi theek hai
DB_PATH=/tmp/arpit.db
APK_DIR=/tmp/apks
UP_DIR=/tmp/arpit-up

# ek APK ka max size (MB). 512MB RAM pe 100 se zyada na rakho
MAX_APK_MB=100

# ================= ANDROID BUILD =================
# Docker image me ye paths fix hain, local pe SDK ka apna path daalo
ANDROID_JAR=/opt/android/platforms/android-34/android.jar
BUILD_TOOLS=/opt/android/build-tools/34.0.0
KEYSTORE=/app/keys/arpit.jks
KS_PASS=Arpit@2026
KS_ALIAS=arpit
