# ================= SERVER =================
PORT=3000

# lamba random hex. banao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=badlo_ye_kuch_lamba_random

# Vercel project ka domain (https://xyz.vercel.app). APK ke andar bake hota hai.
# Domain final hone ke BAAD hi build karna.
BASE_URL=https://your-app.vercel.app

# Vercel pe /tmp hi rahega (FS read-only hai)
DB_PATH=/tmp/arpit.db
APK_DIR=/tmp/apks

# ================= ANDROID BUILD (sirf local PC / VPS) =================
# Android SDK: sdkmanager "platforms;android-34"
ANDROID_JAR=/opt/android/platforms/android-34/android.jar
# sdkmanager "build-tools;34.0.0"
BUILD_TOOLS=/opt/android/build-tools/34.0.0
# keytool -genkeypair -v -keystore arpit.jks -alias arpit -keyalg RSA -keysize 2048 -validity 10000 -storepass 'Arpit@2026' -dname "CN=Arpit"
KEYSTORE=/opt/keystore/arpit.jks
KS_PASS=Arpit@2026
KS_ALIAS=arpit
